rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'chethiyabandara0001@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Strictly enforce that images in Firestore are URLs (e.g. Cloudflare R2 links) and NEVER raw base64 data: URLs
    function isR2ImageLinksOnly(data) {
      return data.coverImage is string &&
        data.coverImage.size() >= 1 &&
        data.coverImage.size() <= 2048 &&
        !data.coverImage.matches('^data:.*') &&
        data.images is list &&
        data.images.size() >= 1 &&
        data.images.size() <= 10 &&
        data.images[0] is string &&
        data.images[0].size() <= 2048 &&
        !data.images[0].matches('^data:.*');
    }

    function isValidComment(data) {
      return data.keys().hasAll(['postId', 'authorName', 'content', 'createdAt']) &&
      data.keys().hasOnly(['postId', 'authorName', 'content', 'createdAt']) &&
      data.postId is string && data.postId.size() >= 1 && data.postId.size() <= 128 && data.postId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
      data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
      data.createdAt is timestamp;
    }

    // Connection health check endpoint (read-only)
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, write: if false;
    }

    // Site settings state (taxonomy categories/collections)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId);
    }

    // Admins directory (strictly read-only for owner/admin)
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isSignedIn() && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }

    // Public Story Posts Collection (public read, admin CRUD with R2 link enforcement)
    match /posts/{postId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(postId) && isR2ImageLinksOnly(incoming());
      allow delete: if isAdmin() && isValidId(postId);

      // Public Post Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;

        allow create: if isValidId(postId) &&
          isValidId(commentId) &&
          isValidComment(incoming()) &&
          incoming().postId == postId &&
          incoming().createdAt == request.time;

        allow update: if false;
        allow delete: if isAdmin() && isValidId(postId) && isValidId(commentId);
      }
    }
  }
}
