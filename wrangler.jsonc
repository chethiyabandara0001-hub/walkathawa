{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "walkathawa",
  "main": "dist/_worker.js",
  "compatibility_date": "2026-11-04",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
